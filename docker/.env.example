# Copy this file to `docker/.env` and edit the paths/credentials for your machine.
#
# These values feed docker-compose.yml.

# Absolute path to this repository (mounted into the containers at /app).
VOL_APP=/path/to/teglon_O4
# Absolute path to the MySQL data directory (persists the database).
VOL_DB=/path/to/DATABASE
# Absolute path to the dust map directory.
VOL_DUSTMAPS=/path/to/DUST_MAP

# MySQL root password for the bundled DB container.
DB_PWD=change-me

# Host port mapped to the container's MySQL 3306. Optional: only needed if you want
# to inspect the DB from the host (e.g. MySQL Workbench). The pipeline does NOT need it.
LOCAL_DB_PORT=53306

# Resource limits for the worker/CLI containers.
CPU_LIMIT=8.0
MEM_LIMIT=16gb
